  "main": "dist/server.js",
  "scripts": {
    "chat": "cross-env NODE_ENV=development tsx src/scripts/chat.ts",
    "simulate": "cross-env NODE_ENV=development tsx src/scripts/simulateMessage.ts",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
